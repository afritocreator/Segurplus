# Copiar a .streamlit/secrets.toml (ese SÍ está en .gitignore) para desarrollo
# local, o cargar los mismos valores en Streamlit Community Cloud:
# Settings -> Secrets del app, en el dashboard de share.streamlit.io.

GEMINI_API_KEY = "tu-api-key-de-aistudio.google.com"

# Piloto transitorio: si no se configura OIDC_PROVIDER se usa esta contraseña
# compartida. En producción la app falla cerrada si falta ambas opciones.
APP_PASSWORD = "elegir-una-clave-y-compartirla-por-fuera-de-github"

# Fuente durable de producción. DATABASE_URL y S3_BUCKET se leen como
# variables de entorno/secrets del proveedor; nunca se commitean.
# DATABASE_URL = "postgresql://usuario:clave@host:5432/segurplus?sslmode=require"
# S3_BUCKET = "segurplus-evidencia-privada"
# S3_REGION = "us-east-1"
# S3_ENDPOINT_URL = "https://endpoint-s3-compatible.example"

# Identidad individual (reemplaza APP_PASSWORD cuando se configura).
# OIDC_PROVIDER = "microsoft"
# ROLE_ADMINISTRADOR_EMAILS = "admin@empresa.com"
# ROLE_RESPONSABLE_EMAILS = "compras@empresa.com"
# ROLE_REVISOR_EMAILS = "revision@empresa.com"
# ROLE_CARGADOR_EMAILS = "cargas@empresa.com"
