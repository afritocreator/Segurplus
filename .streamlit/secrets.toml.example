# Copiar a .streamlit/secrets.toml (ese SÍ está en .gitignore) para desarrollo
# local, o cargar los mismos valores en Streamlit Community Cloud:
# Settings -> Secrets del app, en el dashboard de share.streamlit.io.

GEMINI_API_KEY = "tu-api-key-de-aistudio.google.com"

# La app se publica PÚBLICA (ver docs/decisiones/ADR-002-deploy.md) porque el
# plan gratis de Streamlit Cloud solo permite una app privada por workspace,
# y ese lugar ya lo ocupa Consultora. APP_PASSWORD es la contraseña
# compartida que pide la app antes de mostrar cualquier pantalla -- sin esta
# clave configurada, la app NO pide contraseña (útil para desarrollo local).
APP_PASSWORD = "elegir-una-clave-y-compartirla-por-fuera-de-github"
