{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch:*)",
      "Bash(git show:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m ruff:*)",
      "Read(**)",
      "Glob(**)",
      "Grep(**)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git checkout:*)",
      "Bash(git reset:*)",
      "Bash(git rm:*)"
    ],
    "deny": [
      "Bash(rm -rf data/reales*)",
      "Bash(git push --force*)",
      "Bash(git add data/reales*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/guard_facturas.py"
          }
        ]
      }
    ]
  }
}
